# Copie ce fichier en ".env" (jamais versionne) et renseigne tes cles.
# Sans aucune cle, Bobine tourne en mode demo : script gabarit, visuels
# abstraits, pas de voix. Utile pour verifier l'installation.

# Script, images et clips IA (https://platform.openai.com)
OPENAI_API_KEY=

# Voix francaise (facultatif ; sinon voix OpenAI si la cle OpenAI est presente)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

