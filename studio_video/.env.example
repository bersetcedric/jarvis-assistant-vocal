# Copie ce fichier en ".env" (jamais versionne) et renseigne tes cles.
# Sans aucune cle, Bobine tourne en mode demo : script gabarit, visuels
# abstraits, pas de voix. Utile pour verifier l'installation.

# Script et images par Agnes AI (prioritaire sur OpenAI)
AGNES_API_KEY=

# Clips IA et voix de repli ; script et images si AGNES_API_KEY est vide (https://platform.openai.com)
OPENAI_API_KEY=

# Voix francaise (facultatif ; sinon voix OpenAI si la cle OpenAI est presente)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Reglages facultatifs
# STUDIO_MODELE_SCRIPT=agnes-2.5-flash
# Autre API au format OpenAI pour le script :
# STUDIO_SCRIPT_URL=https://exemple.com/v1
# STUDIO_SCRIPT_CLE=
# STUDIO_MODELE_IMAGE=agnes-image-2.5-flash
# STUDIO_MODELE_VIDEO=sora-2
# STUDIO_MODELE_VOIX_OPENAI=gpt-4o-mini-tts
# STUDIO_VOIX_OPENAI=alloy
# STUDIO_MODELE_VOIX_ELEVENLABS=eleven_flash_v2_5
# STUDIO_PORT=8765
